HARNESS_DATABASE_PATH=data/harness.db
ARTIFACT_ROOT=data/artifacts

# fake | colab | local
GPU_RUNNER=fake
GPU_MAX_CONCURRENCY=1
GPU_IDLE_TIMEOUT_SECONDS=300
GPU_SCHEDULER_POLL_SECONDS=0.5
GPU_JOB_TIMEOUT_SECONDS=1800

COLAB_EXECUTABLE=colab
COLAB_SESSION_NAME=agent-music-t4
COLAB_GPU=T4
COLAB_AUTH_PROVIDER=oauth2
COLAB_CLI_CONFIG=data/colab/sessions.json
COLAB_MOUNT_DRIVE=true
COLAB_DRIVE_MOUNT_PATH=/content/drive
COLAB_COMMAND_TIMEOUT_SECONDS=900

FAKE_GPU_JOB_SECONDS=0.05

