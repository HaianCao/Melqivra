HARNESS_DATABASE_PATH=data/harness.db
JOB_STORE=sqlite
POSTGRES_DSN=
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=4
POSTGRES_CONNECT_TIMEOUT_SECONDS=10
ARTIFACT_ROOT=data/artifacts
# filesystem | s3; S3 mode requires JOB_STORE=postgres.
ARTIFACT_STORAGE=filesystem
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=us-east-1
S3_CREATE_BUCKET=false
S3_ADDRESSING_STYLE=auto
S3_CONNECT_TIMEOUT_SECONDS=10
S3_READ_TIMEOUT_SECONDS=60
S3_MAX_ATTEMPTS=3
# Lifecycle work is bounded and disabled for published bytes unless configured.
ARTIFACT_PENDING_TIMEOUT_SECONDS=3600
ARTIFACT_CORRUPT_RETENTION_SECONDS=86400
ARTIFACT_ORPHAN_GRACE_SECONDS=86400
ARTIFACT_PUBLISHED_RETENTION_SECONDS=
ARTIFACT_RECONCILE_BATCH_LIMIT=100
ARTIFACT_RECONCILE_OBJECT_PAGE_SIZE=100
# S3 credentials use the standard AWS credential provider chain. Never commit them.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
TRANSFER_ROOT=data/transfers

# modal | colab | fake | local
GPU_RUNNER=modal
GPU_MAX_CONCURRENCY=1
GPU_IDLE_TIMEOUT_SECONDS=300
GPU_SCHEDULER_POLL_SECONDS=0.5
GPU_JOB_TIMEOUT_SECONDS=1800
GPU_JOB_LEASE_SECONDS=60
GPU_JOB_HEARTBEAT_SECONDS=15
GPU_JOB_MAX_ATTEMPTS=3

# development trusts X-User-Id; injected requires an application Authenticator.
API_AUTH_MODE=development
API_MAX_ACTIVE_JOBS_PER_USER=10
API_MAX_JOB_PAYLOAD_BYTES=65536
API_MAX_REQUEST_BODY_BYTES=131072
API_MAX_PAGE_SIZE=100
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60
API_SSE_POLL_SECONDS=0.25
API_SSE_KEEPALIVE_SECONDS=15
API_SSE_BATCH_SIZE=100

MODAL_EXECUTABLE=modal
MODAL_CLI_VERSION=1.6.3
MODAL_APP_NAME=melqivra-gpu-runner
MODAL_REMOTE_OUTPUT_ROOT=/tmp/agent_music_output
MODAL_ARTIFACT_VOLUME=
MODAL_ARTIFACT_PREFIX=runs
MODAL_COMMAND_TIMEOUT_SECONDS=1800

COLAB_EXECUTABLE=colab
COLAB_CLI_VERSION=0.8.0
COLAB_SESSION_NAME=melqivra-t4
COLAB_GPU=T4
COLAB_AUTH_PROVIDER=oauth2
COLAB_CLI_CONFIG=data/colab/sessions.json
COLAB_MOUNT_DRIVE=true
COLAB_DRIVE_MOUNT_PATH=/content/drive
COLAB_REMOTE_CANCEL_ROOT=/content/agent_music_control
COLAB_CACHE_MANIFEST_PATH=
COLAB_REMOTE_CACHE_ROOT=
COLAB_COMMAND_TIMEOUT_SECONDS=900

FAKE_GPU_JOB_SECONDS=0.05

